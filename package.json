{
  "name": "contractor-time-desktop",
  "productName": "Contractor Time",
  "version": "0.0.1",
  "description": "Time tracking and invoicing for remote contractors, kept in a shared OneDrive folder.",
  "author": "Anabaptist Brotherhood",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "preversion": "npm test",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.anabaptistbrotherhood.contractortime",
    "productName": "Contractor Time",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "contractor-time",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ContractorTime-Setup-${version}.${ext}"
    }
  }
}
