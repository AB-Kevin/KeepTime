{
  "name": "keeptime",
  "productName": "KeepTime",
  "version": "0.3.0",
  "description": "Time tracking and invoicing for remote contractors, kept in a shared OneDrive folder.",
  "author": "Anabaptist Brotherhood",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "preversion": "npm test",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "ab-common": "git+https://github.com/AB-Kevin/ab-common.git#v1.1.0"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.anabaptistbrotherhood.contractortime",
    "productName": "KeepTime",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "KeepTime",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "KeepTime-Setup-${version}.${ext}"
    }
  }
}
